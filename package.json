{
  "name": ".github",
  "version": "1.38.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "pnpm run format:prettier",
    "format:prettier": "prettier --write . --config prettier.config.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:symlinks && pnpm lint:stylecheck && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts && pnpm lint:templates",
    "lint:symlinks": "node scripts/check-symlinks.js",
    "lint:templates": "prettier --check --no-config --no-editorconfig cli/internal/repocfg/templates"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=23.11.0",
    "npm": ">=10.9.2"
  }
}
